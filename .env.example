# ============================================================================
# 8. Web search / fetch tools
# ============================================================================

# EXA_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# PERPLEXITY_API_KEY=
# FIRECRAWL_API_KEY=
# JINA_API_KEY=
# KAGI_API_KEY=

# ============================================================================
# 9. Networking
# ============================================================================

# Standard proxy variables. Loopback, link-local, private ranges (10/8,
# 172.16/12, 192.168/16), and NO_PROXY targets always bypass both omp's
# provider proxy wrapper and ompweb's undici EnvHttpProxyAgent.
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=

# Process-wide provider proxy for omp, and per-provider overrides
# (provider ID uppercased, non-alphanumerics → '_', e.g. PI_PROXY_GITHUB_COPILOT).
# PI_PROXY=
# PI_PROXY_<PROVIDER>=

# Extra CA chain (path or inline PEM).
# NODE_EXTRA_CA_CERTS=

# ============================================================================
# 10. Behavior / tuning
# ============================================================================

# Ephemeral model-role overrides.
# PI_SMOL_MODEL=
# PI_SLOW_MODEL=
# PI_PLAN_MODEL=

# MCP client request timeout (ms). Default 30000; 0 disables.
# OMP_MCP_TIMEOUT_MS=30000

# Disable auto session title generation (any non-empty value).
# PI_NO_TITLE=

# Skip automatic interactive setup scenes (the image sets this to 1).
# OMP_SKIP_SETUP=1

# Filesystem walker worker count (default 4; 0 = auto, 1 = serial).
# PI_WALK_WORKERS=

# Subagent output caps.
# PI_TASK_MAX_OUTPUT_BYTES=500000
# PI_TASK_MAX_OUTPUT_LINES=5000

# Threads / image format.
# OMP_NUM_THREADS=
# OMP_NO_WEBP=

# Disable lspmux and spawn LSP servers directly.
# PI_DISABLE_LSPMUX=

# Desktop notifications (off / 0 / false suppress).
# PI_NOTIFICATIONS=

# OpenTelemetry — export initializes only when at least one signal has an
# endpoint. OTEL_SDK_DISABLED=true disables initialization entirely.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=
# OTEL_EXPORTER_OTLP_METRICS_ENDPOINT=
# OTEL_SERVICE_NAME=

# ============================================================================
# 11. Custom OpenAI-compatible provider
# ============================================================================
# Point omp at any OpenAI-compatible endpoint by setting the OMP_PROVIDER_*
# vars below. The entrypoint writes ~/.omp/agent/models.yml + config.yml on
# first start. Idempotent: existing files (your own edits) are left alone.
# Leave blank to use the built-in providers above.
#
# Examples:
#
# OpenRouter:
#   OMP_PROVIDER_LABEL=openrouter
#   OMP_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#   OMP_PROVIDER_API_KEY=sk-or-v1-...
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=anthropic/claude-3.5-sonnet
#   OMP_PROVIDER_MODEL_NAME=Claude 3.5 Sonnet
#
# LM Studio (local, no auth):
#   OMP_PROVIDER_LABEL=lmstudio
#   OMP_PROVIDER_BASE_URL=http://host.docker.internal:1234/v1
#   OMP_PROVIDER_API_KEY=lm-studio
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=qwen2.5-coder-7b
#
# Ollama (local, no auth):
#   OMP_PROVIDER_LABEL=ollama
#   OMP_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
#   OMP_PROVIDER_API_KEY=ollama
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=qwen2.5-coder:7b
#
# OMP_PROVIDER_LABEL=
# OMP_PROVIDER_BASE_URL=
# OMP_PROVIDER_API_KEY=
# OMP_PROVIDER_API=openai-completions
# OMP_PROVIDER_MODEL_ID=
# OMP_PROVIDER_MODEL_NAME=
#
# Override modelRoles.default. Format: <LABEL>/<MODEL_ID>. For OpenRouter
# models whose ID contains '/', set this explicitly to avoid ambiguity:
#   OMP_DEFAULT_MODEL=openrouter/anthropic/claude-3.5-sonnet
# OMP_DEFAULT_MODEL=
