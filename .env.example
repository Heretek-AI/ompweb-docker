# Copy this file to .env and fill in the values. .env is git-ignored and must
# never be committed.

# ---- Required ----

# OMP_WEB_PASSWORD gates access to the web UI. The upstream launcher refuses
# to bind to a non-loopback address without it. Pick something strong.
OMP_WEB_PASSWORD=changeme-please

# ---- Image selection (optional) ----

# Owner of the GHCR image. Override if you forked this repo.
GHCR_OWNER=heretek-ai

# Image tag. `latest` tracks main; pin to a specific tag for reproducibility.
# TAG=latest

# ---- omp behavior (optional) ----

# Where omp stores config, sessions, models, MCP servers. Default: /data/omp
# (backed by the `ompweb_data` named volume — do not point this at a host
# directory unless you know what you're doing).
# PI_CODING_AGENT_DIR=/data/omp

# Override the omp binary path. Only change if you're mounting your own build.
# OMP_WEB_OMP_BIN=/usr/local/bin/omp

# Bind address. Default 0.0.0.0 (LAN-accessible, requires password).
# Set to 127.0.0.1 if you're reverse-proxying through localhost only.
# OMP_WEB_HOSTNAME=0.0.0.0

# Port. Default 30177 (ompweb default).
# PORT=30177

# ---- Provider API keys ----
# These are passed through to omp at runtime. omp reads them from env directly.
# See https://github.com/can1357/oh-my-pi for the full provider list.
#
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# ... etc.

# ---- Workspace bind mount (optional) ----

# Point this at the directory you want omp to work on. After changing this,
# uncomment the workspace volume in docker-compose.yml.
# WORKSPACE_DIR=$HOME/code

# ---- Custom OpenAI-compatible provider (optional) ----
# Point omp at any OpenAI-compatible endpoint (OpenRouter, LM Studio,
# Together AI, Ollama with OpenAI-compat shim, vLLM, etc.) by setting
# the six OMP_PROVIDER_* vars below. The entrypoint will write
# ~/.omp/agent/models.yml + config.yml on first start. Idempotent: if
# those files already exist (you wrote them yourself), they're left
# alone. Leave all six blank to use the built-in providers above.
#
# Examples:
#
# OpenRouter:
#   OMP_PROVIDER_LABEL=openrouter
#   OMP_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
#   OMP_PROVIDER_API_KEY=sk-or-v1-...
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=anthropic/claude-3.5-sonnet
#   OMP_PROVIDER_MODEL_NAME=Claude 3.5 Sonnet
#
# LM Studio (local, no auth):
#   OMP_PROVIDER_LABEL=lmstudio
#   OMP_PROVIDER_BASE_URL=http://host.docker.internal:1234/v1
#   OMP_PROVIDER_API_KEY=lm-studio
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=qwen2.5-coder-7b
#
# Ollama (local, no auth):
#   OMP_PROVIDER_LABEL=ollama
#   OMP_PROVIDER_BASE_URL=http://host.docker.internal:11434/v1
#   OMP_PROVIDER_API_KEY=ollama
#   OMP_PROVIDER_API=openai-completions
#   OMP_PROVIDER_MODEL_ID=qwen2.5-coder:7b
#
# OMP_PROVIDER_LABEL=
# OMP_PROVIDER_BASE_URL=
# OMP_PROVIDER_API_KEY=
# OMP_PROVIDER_API=openai-completions
# OMP_PROVIDER_MODEL_ID=
# OMP_PROVIDER_MODEL_NAME=
#
# Override modelRoles.default. Format: <LABEL>/<MODEL_ID>. For OpenRouter
# models whose ID contains '/', set this explicitly to avoid ambiguity:
#   OMP_DEFAULT_MODEL=openrouter/anthropic/claude-3.5-sonnet
# OMP_DEFAULT_MODEL=