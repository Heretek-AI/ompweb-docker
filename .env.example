# omp-sandbox environment file.
#
# Copy to .env (`cp .env.example .env`), edit, and `docker compose up -d`.
# .env is git-ignored and must never be committed.
#
# Scope: USER-SETTABLE variables only. Internal handshake variables
# (OMP_WEB_PACKAGE_DIR, OMP_WEB_PORT, OMP_WEB_LAUNCHER_PID,
# OMP_WEB_RESTART_DESCRIPTOR, OMP_DAEMON_*, OMP_BLOB_BROKER_*, OMP_LSP_MUX_*,
# PI_TOOL_BRIDGE_*, PI_EVAL_*), test-only variables, and auto-detected terminal
# variables (TERM, COLORTERM, TMUX_PANE, ...) are intentionally omitted.

# ============================================================================
# 1. Image
# ============================================================================

# Owner of the GHCR image. Override when using a fork's published image.
GHCR_OWNER=heretek-ai

# Image tag. `latest` tracks main; pin to a published tag for reproducibility.
# TAG=latest

# ============================================================================
# 2. Host identity
# ============================================================================

# UID/GID the container remaps the `omp` user to, so files created in the
# mounted volumes are owned by you. Use `id -u` / `id -g` on the host.
PUID=1000
PGID=1000

# Host-side port. The container always listens on 3000.
# OMPWEB_PORT=3000

# ============================================================================
# 3. Web auth / UI
# ============================================================================

# REQUIRED unless OMP_WEB_HOSTNAME is 127.0.0.1: the upstream launcher refuses
# a non-loopback bind without a password and exits 1. This is the only auth
# boundary in front of the agent.
OMP_WEB_PASSWORD=changeme-please

# Bind address inside the container. Default 0.0.0.0 (LAN-accessible).
# OMP_WEB_HOSTNAME=0.0.0.0

# Do not try to open a browser (the image sets this by default).
# OMP_WEB_NO_OPEN=1

# omp binary the web UI spawns per session.
# OMP_WEB_OMP_BIN=/usr/local/bin/omp

# Speech-to-text endpoint (OpenAI-compatible). Unset → POST /api/stt returns 501.
# OMP_WEB_STT_ENDPOINT=
# OMP_WEB_STT_KEY=
# OMP_WEB_STT_MODEL=

# Skills marketplace base URL.
# SKILLS_API_URL=https://skills.sh

# ============================================================================
# 4. Mounts
# ============================================================================

# Your code. This is the workspace omp edits.
# WORKSPACE_DIR=./workspace
# Agent state: sessions, blobs, projects.json, models.yml, config.yml, agent.db.
# OMP_DATA_DIR=./data/omp
# Tool config: gh auth, git config.
# OMP_CONFIG_DIR=./data/config
# SSH keys (mounted read-only). `chmod 700 data/ssh`.
# OMP_SSH_DIR=./data/ssh

# Default workspace inside the container. NOTE: this is a CONTAINER-DEFINED
# variable — the entrypoint consumes it (workspace creation + projects.json
# seed). Neither upstream repo reads OMP_DEFAULT_CWD.
# OMP_DEFAULT_CWD=/workspace

# ============================================================================
# 5. Container sidecar (optional long-running companion process)
# ============================================================================

# Runs inside the same sandbox as the unprivileged omp user. Empty = disabled.
# Examples:
#   OMP_SIDECAR_CMD='omp auth-broker serve --bind=127.0.0.1:8765'
#   OMP_SIDECAR_CMD='omp auth-gateway serve --bind=127.0.0.1:4000'
# OMP_SIDECAR_CMD=

# ============================================================================
# 6. Storage overrides
# ============================================================================

# Config root dirname under $HOME (default .omp).
# PI_CONFIG_DIR=.omp

# Full agent-dir override. Unset = $HOME/.omp/agent, i.e. the mounted volume.
# PI_CODING_AGENT_DIR=

# Platform path-list of settings overlays (':' on Unix).
# PI_CONFIG_FILES=

# Named profile selectors.
# OMP_PROFILE=
# PI_PROFILE=

# Agent-managed worktrees directory (default ~/.omp/wt).
# OMP_WORKTREE_DIR=

# XDG redirects. NOTE: honored only when $XDG_*_HOME/omp already exists.
# XDG_DATA_HOME=
# XDG_STATE_HOME=
# XDG_CACHE_HOME=

# ============================================================================
# 7. Provider credentials (all optional; uncomment the ones you use)
# ============================================================================

# --- Anthropic ---
# ANTHROPIC_API_KEY=
# ANTHROPIC_OAUTH_TOKEN=
# ANTHROPIC_FOUNDRY_API_KEY=

# --- OpenAI ---
# OPENAI_API_KEY=
# OPENAI_CODEX_OAUTH_TOKEN=
# OPENAI_BASE_URL=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_BASE_URL=
# AZURE_OPENAI_RESOURCE_NAME=
# AZURE_OPENAI_API_VERSION=

# --- Google ---
# GEMINI_API_KEY=
# GOOGLE_API_KEY=
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_VERTEX_LOCATION=

# --- Other hosted providers ---
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
